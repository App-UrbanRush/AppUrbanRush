# ═══════════════════════════════════════════════════════════
# .env.production — Variables de entorno para producción
# ═══════════════════════════════════════════════════════════
# Copiar como .env en el servidor y rellenar los valores.
# NUNCA subir este archivo con valores reales a Git.
# ═══════════════════════════════════════════════════════════

NODE_ENV=production
CORS_ORIGINS=https://tu-dominio.com,https://www.tu-dominio.com

DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=urbanrush
DB_USER=postgres
DB_PASSWORD=TU_PASSWORD_SEGURO

JWT_SECRET=TU_JWT_SECRET_SEGURO_DE_64_CARACTERES

# Google OAuth (actualizar callback con HTTPS)
GOOGLE_CLIENT_ID=tu_google_client_id
GOOGLE_CLIENT_SECRET=tu_google_secret
GOOGLE_CALLBACK_URL=https://tu-dominio.com/api/auth/google/callback

# Frontend
FRONTEND_URL=https://tu-dominio.com

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_email@gmail.com
SMTP_PASS=tu_app_password
SMTP_FROM=UrbanRush <tu_email@gmail.com>

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# MongoDB
MONGO_URI=mongodb://localhost:27017/urbanrush

# Wompi (Producción)
WOMPI_PUBLIC_KEY=pub_prod_xxx
WOMPI_PRIVATE_KEY=prv_prod_xxx
WOMPI_EVENTS_SECRET=prod_events_xxx
WOMPI_BASE_URL=https://production.wompi.co/v1

# Backup
BACKUP_PATH=./backups
BACKUP_RETENTION_DAYS=30

# Cloudinary
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# Encryption
ENCRYPTION_MASTER_KEY=TU_MASTER_KEY_DE_64_CARACTERES_HEX

# GROQ (IA)
GROQ_API_KEY=tu_groq_api_key

import { MarkMessagesReadUseCase } from '../../application/use-cases/mark-messages-read.use-case';
import { GetUnreadCountUseCase } from '../../application/use-cases/get-unread-count.use-case';

@ApiTags('Chat')
@ApiBearerAuth()
@UseGuards(JwtAuthGuard, RolesGuard)

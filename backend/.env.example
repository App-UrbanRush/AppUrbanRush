# ==========================================
# Configuración del Entorno
# ==========================================
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ==========================================
# Bases de Datos
# ==========================================
# Nota: Si usas Docker, los HOST serán los nombres de los servicios (postgres, mongo, redis)
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=urbanrush
DB_USER=postgres
DB_PASSWORD=tu_contraseña_aqui

REDIS_HOST=localhost
REDIS_PORT=6379

MONGO_URI=mongodb://localhost:27017/urbanrush

# ==========================================
# Seguridad
# ==========================================
# Genera uno nuevo usando: openssl rand -hex 64
JWT_SECRET=tu_secreto_para_jwt
# Genera uno nuevo: openssl rand -hex 32
ENCRYPTION_MASTER_KEY=tu_clave_maestra_de_32_bytes

# ==========================================
# IA (Groq)
# ==========================================
GROQ_API_KEY=gsk_tu_clave_de_groq_aqui

# ==========================================
# Google Auth
# ==========================================
GOOGLE_CLIENT_ID=tu_id_de_cliente_google
GOOGLE_CLIENT_SECRET=tu_secret_de_cliente_google
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# ==========================================
# Frontend
# ==========================================
VITE_API_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# ==========================================
# Email (SMTP)
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_email@gmail.com
SMTP_PASS=tu_contraseña_de_aplicacion
SMTP_FROM="UrbanRush <tu_email@gmail.com>"

# ==========================================
# Pasarela de Pagos (Wompi)
# ==========================================
WOMPI_PUBLIC_KEY=pub_test_...
WOMPI_PRIVATE_KEY=prv_test_...
WOMPI_EVENTS_SECRET=test_events_...
WOMPI_BASE_URL=https://sandbox.wompi.co/v1
WOMPI_PAYOUTS_PATH=/payouts
PAYOUTS_MODE=mock

# ==========================================
# Cloudinary
# ==========================================
CLOUDINARY_CLOUD_NAME=tu_nombre_de_cloud
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# ==========================================
# Configuración del Sistema
# ==========================================
BACKUP_PATH=./backups
BACKUP_RETENTION_DAYS=7
DELIVERY_FEE=3000
PLATFORM_COMMISSION=0.15
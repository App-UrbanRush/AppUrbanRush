}

/* Modal Register */
.courier-modal-register {
  margin-top: 20px;
  padding-top: 18px;
  border-top: 1px solid #f3f4f6;
}

.courier-modal-register .courier-dashboard-card-btn,
.courier-modal-register .courier-dashboard-card-btn-pending,
.courier-modal-register .courier-dashboard-card-btn-accepted,

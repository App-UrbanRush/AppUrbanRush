.dark-mode-wrapper.dark-mode .courier-section-icon { background: rgba(139,92,246,0.12); color: #a78bfa; }
.dark-mode-wrapper.dark-mode .courier-section-icon.active-pulse { background: rgba(139,92,246,0.18); color: #c4b5fd; }

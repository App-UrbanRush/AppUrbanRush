/* CONTAINER */
.login-container {
  display: flex;
  min-height: 100vh;
}

.login-left {
  flex: 1;
  position: relative;
  overflow: hidden;
}

/* Degradado en el borde derecho que funde la imagen con el panel de login
   para que no se note el corte entre las dos mitades */
.login-left::after {
  content: "";
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 28%;
  background: linear-gradient(to right, rgba(248, 249, 251, 0) 0%, #f8f9fb 100%);
  pointer-events: none;
  z-index: 5;
}

/* usamos IMG real en vez de background */
.login-left img {
  width: 100%;
  height: 100%;
  object-fit: cover;   /* 🔥 clave */
  object-position: center; /* centra bien */
  /* Efecto Ken Burns: zoom + movimiento automático para dar dinamismo */
  transform-origin: center;
  will-change: transform;
  animation: login-kenburns 22s ease-in-out infinite alternate;
}

@keyframes login-kenburns {
  0% {
    transform: scale(1) translate(0, 0);
  }
  50% {

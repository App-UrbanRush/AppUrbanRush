  font-weight: 700;
  color: #111827;
}

.courier-modal-type {
  font-size: 13px;
  color: #9ca3af;
  font-weight: 500;
}

/* Modal Sections */
.courier-modal-section {
  margin-bottom: 22px;
}

.courier-modal-section h3 {
  margin: 0 0 14px;
  font-size: 14px;
  font-weight: 700;
  color: #374151;
  text-transform: uppercase;

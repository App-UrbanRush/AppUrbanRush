          style={{
            padding: '10px 24px',
            background: '#e8500a',
            color: '#fff',
            border: 'none',
            borderRadius: '8px',
            fontSize: '14px',
            fontWeight: 600,
            cursor: 'pointer'
          }}
        >
          Intentar de nuevo
        </button>
      </div>
    );
  }

  return (
    <div className="home">
      <HeroBanner data={data.heroBanner} />
      <RecommendedProducts products={data.recommendedProducts} />
      <NearbyStores stores={data.nearbyStores} />
    </div>
  );
};

export default HomeNew;

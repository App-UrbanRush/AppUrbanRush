  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: #22c55e;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from { opacity: 0; transform: scale(0.8); }
  to { opacity: 1; transform: scale(1); }
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.spinner {
  animation: spin 1s linear infinite;
}

/* Photo Gallery */
.photos-gallery {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
  gap: 16px;
  margin-top: 12px;
}

.photo-gallery-item {
  position: relative;
  aspect-ratio: 1;
  border-radius: 10px;
  overflow: hidden;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  transition: transform 0.2s ease;
}

.photo-gallery-item:hover {
  transform: scale(1.02);
}

.photo-gallery-item img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.photo-gallery-item.uploading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8px;
  background: #f5f5f5;
  color: #666;
  border: 2px dashed #e0e0e0;
}

.photo-gallery-item.uploading .spinner {
  color: #2563eb;
}

.photo-delete-btn {
  position: absolute;
  top: 8px;
  right: 8px;
  width: 30px;
  height: 30px;
  border-radius: 50%;
  background: rgba(239, 68, 68, 0.9);
  color: #fff;
  border: none;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
  opacity: 0;
}

.photo-gallery-item:hover .photo-delete-btn {
  opacity: 1;
}

.photo-delete-btn:hover {
  background: #dc2626;
  transform: scale(1.1);
}

.photo-delete-btn:disabled {
  background: #999;
  cursor: not-allowed;
}

.photo-gallery-add {
  aspect-ratio: 1;
  border: 2px dashed #d0d0d0;
  border-radius: 10px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10px;
  cursor: pointer;
  transition: all 0.2s ease;
  color: #888;
  font-size: 13px;
  font-weight: 500;
}

.photo-gallery-add:hover {
  border-color: #2563eb;
  background: #eff6ff;
  color: #2563eb;
}

.photos-empty {
  margin-top: 12px;
  font-size: 14px;
  color: #999;
  text-align: center;
  padding: 20px;
  background: #f9f9f9;
  border-radius: 8px;
}

/* Save button */
.settings-actions {
  display: flex;
  justify-content: flex-end;
}

.save-btn {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 12px 32px;
  background: #2563eb;
  color: #fff;
  border: none;
  border-radius: 8px;
  font-size: 16px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
}

.save-btn:hover {
  background: #1d4ed8;
  transform: translateY(-2px);
  box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);
}

.save-btn:active {
  transform: translateY(0);
}

.save-btn:disabled {
  opacity: 0.7;
  cursor: not-allowed;
  transform: none;
}

.save-btn.saved {
  background: #22c55e;
}

.save-btn.saved:hover {
  background: #16a34a;
}

/* Dark mode styles */
.dark-mode-wrapper.dark-mode .vendor-settings-header h1 {
  color: #fff;
}

.dark-mode-wrapper.dark-mode .vendor-settings-header p {
  color: rgba(255, 255, 255, 0.7);
}

.dark-mode-wrapper.dark-mode .settings-section {
  background: #1a1a2e;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
}

.dark-mode-wrapper.dark-mode .settings-section h2 {
  color: #fff;
  border-bottom-color: rgba(255, 255, 255, 0.1);
}

.dark-mode-wrapper.dark-mode .form-group label {
  color: rgba(255, 255, 255, 0.9);
}

.dark-mode-wrapper.dark-mode .form-group input,
.dark-mode-wrapper.dark-mode .form-group textarea {
  background: rgba(255, 255, 255, 0.05);
  border-color: rgba(255, 255, 255, 0.2);
  color: #fff;
}

.dark-mode-wrapper.dark-mode .form-group input:focus,
.dark-mode-wrapper.dark-mode .form-group textarea:focus {
  border-color: #2563eb;
  box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.2);
}

.dark-mode-wrapper.dark-mode .form-group input::placeholder,
.dark-mode-wrapper.dark-mode .form-group textarea::placeholder {
  color: rgba(255, 255, 255, 0.5);
}

.dark-mode-wrapper.dark-mode .readonly-field {
  background: rgba(255, 255, 255, 0.08) !important;
  color: #fff !important;
}

.dark-mode-wrapper.dark-mode .upload-area {
  border-color: rgba(255, 255, 255, 0.2);
  color: rgba(255, 255, 255, 0.7);
}

.dark-mode-wrapper.dark-mode .upload-area:hover {
  border-color: #2563eb;
  background: rgba(37, 99, 235, 0.1);
  color: #2563eb;
}

.dark-mode-wrapper.dark-mode .photo-gallery-item.uploading {
  background: rgba(255, 255, 255, 0.08);
  color: rgba(255, 255, 255, 0.7);
  border-color: rgba(255, 255, 255, 0.2);
}

.dark-mode-wrapper.dark-mode .photo-gallery-add {
  border-color: rgba(255, 255, 255, 0.2);
  color: rgba(255, 255, 255, 0.5);
}

.dark-mode-wrapper.dark-mode .photo-gallery-add:hover {
  border-color: #2563eb;
  background: rgba(37, 99, 235, 0.1);
  color: #2563eb;
}

.dark-mode-wrapper.dark-mode .photos-empty {
  background: rgba(255, 255, 255, 0.05);
  color: rgba(255, 255, 255, 0.5);
}

.dark-mode-wrapper.dark-mode .logo-preview img {
  background: rgba(255, 255, 255, 0.05);
}

.dark-mode-wrapper.dark-mode .logo-preview.uploading {
  background: rgba(255, 255, 255, 0.05);
  color: rgba(255, 255, 255, 0.5);
}

.dark-mode-wrapper.dark-mode .remove-logo-btn {
  background: rgba(0, 0, 0, 0.8);
  color: #fff;
}

.dark-mode-wrapper.dark-mode .photo-gallery-item {
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
}

.dark-mode-wrapper.dark-mode .photo-delete-btn:disabled {
  background: rgba(255, 255, 255, 0.15);
}

/* Location button */
.vendor-locate-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 8px 16px;
  font-size: 13px;
  font-weight: 600;
  border-radius: 8px;
  border: 1px solid #e0e0e0;
  background: #fff;
  color: #333;
  cursor: pointer;
  transition: all 0.2s ease;
}

.vendor-locate-btn:hover {
  border-color: #2563eb;
  color: #2563eb;
  background: #eff6ff;
}

.vendor-locate-btn:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

.vendor-coords {
  font-size: 12px;
  color: #888;
  font-family: monospace;
}

/* Responsive */
@media (max-width: 768px) {
  .vendor-settings-header h1 {
    font-size: 24px;
  }

  .settings-section {
    padding: 24px;
  }

  .settings-section h2 {
    font-size: 18px;
  }

  .photos-gallery {
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 12px;
  }

  .logo-preview,
  .upload-area {
    width: 150px;
    height: 150px;
  }
}

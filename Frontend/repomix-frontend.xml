  transition: background 0.2s;
}

.earnings-modal-close:hover { background: #e5e7eb; }

@media (max-width: 600px) {
  .earnings-row { grid-template-columns: 1fr 1fr; gap: 6px; }
  .earnings-row-date { justify-self: start; }

.dark-mode-wrapper.dark-mode .courier-welcome-modal h2 {
  color: #f9fafb;
}

.dark-mode-wrapper.dark-mode .courier-welcome-modal > p {
  color: rgba(255, 255, 255, 0.6);
}

.dark-mode-wrapper.dark-mode .courier-welcome-modal > p strong {
  color: #f9fafb;
}

.dark-mode-wrapper.dark-mode .courier-welcome-step {

}
.dark-mode-wrapper.dark-mode .earnings-card-value,
.dark-mode-wrapper.dark-mode .earnings-section h2,
.dark-mode-wrapper.dark-mode .earnings-account-bank,
.dark-mode-wrapper.dark-mode .earnings-row-order {

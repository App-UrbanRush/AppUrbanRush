/* ============================================
   Responsive
   ============================================ */
@media (max-width: 1200px) {
  .courier-dashboard-active-layout {
    grid-template-columns: 1fr;
  }
  
  .courier-dashboard-right {
    position: relative;
    top: 0;
    height: 450px;
    min-height: auto;
  }
}

@media (max-width: 768px) {
  .courier-dashboard-card {
    flex-direction: column;
  }

  .courier-dashboard-card-image {
    width: 100%;
    min-height: 160px;
    max-height: 180px;
  }

  .courier-dashboard-card-actions {
    flex-direction: row;
    border-left: none;
    border-top: 1px solid #f5f5f5;
    padding: 12px 16px;
    min-width: 0;
  }

  .courier-dashboard-card-btn,
  .courier-dashboard-card-btn-outline {
    flex: 1;
  }

  .courier-modal { max-width: 100%; border-radius: 16px; }
  .courier-modal-banner { height: 150px; border-radius: 16px 16px 0 0; }
  .courier-modal-photos-grid { grid-template-columns: repeat(2, 1fr); }
  .courier-active-header { flex-direction: column; align-items: flex-start; gap: 12px; }
  .courier-welcome-modal { padding: 28px 24px; }
  
  .courier-dashboard-right {
    height: 350px;
  }
}

/* ============================================
   Carrusel vertical - Pedidos Disponibles
   ============================================ */
.available-carousel-wrap {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: linear-gradient(180deg, #f8f9ff 0%, #f0f2ff 100%);
  border-radius: 16px;
  padding: 8px;
}

.available-carousel {
  height: 155px;
  overflow-y: auto;
  scroll-snap-type: y mandatory;
  scrollbar-width: none;
  -ms-overflow-style: none;
  width: 100%;
  border-radius: 12px;
}

.available-carousel::-webkit-scrollbar { display: none; }

.carousel-card {
  min-height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 3px;
  padding: 8px 14px;
  background: #fff;
  border: 1px solid #e5e7eb;
  border-radius: 12px;
  scroll-snap-align: start;
  box-sizing: border-box;
  margin-bottom: 3px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  transition: box-shadow 0.3s ease;
}

.carousel-card:hover {
  box-shadow: 0 4px 16px rgba(99, 102, 241, 0.1);
}

.carousel-card .courier-order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 0;
}

.carousel-card .courier-order-id {
  font-size: 11px;
  padding: 3px 8px;
  border-radius: 6px;
}

.carousel-card .courier-order-status {
  font-size: 10px;
  padding: 2px 8px;
}

.carousel-card .courier-order-info {
  display: flex;
  align-items: center;
  gap: 5px;
  font-size: 12px;
  color: #374151;
  margin-bottom: 0;
}

.carousel-card .courier-order-info svg {
  width: 12px;
  height: 12px;
}

.carousel-card .courier-accept-order-btn {
  margin-top: 2px;
  padding: 6px 10px;
  font-size: 11px;
  gap: 4px;
  border-radius: 8px;
  box-shadow: 0 2px 6px rgba(99, 102, 241, 0.2);
}

.carousel-arrow {
  background: #fff;
  border: 1px solid #e5e7eb;

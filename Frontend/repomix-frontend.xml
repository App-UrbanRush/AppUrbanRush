  background: white;
  font-size: 14px;
  cursor: pointer;
  transition: all 0.2s ease;
  margin-top: 10px;
}

.doc-input:hover {
  border-color: #ff7a00;
  background: #fff7ed;
}

.doc-input::-webkit-file-upload-button {
  background: linear-gradient(135deg, #ff7a00 0%, #ff8c00 100%);
  color: white;
  border: none;
  padding: 10px 20px;
  border-radius: 8px;
  font-weight: 700;
  cursor: pointer;
  margin-right: 15px;
  transition: all 0.2s ease;
}

.doc-input::-webkit-file-upload-button:hover {
  background: linear-gradient(135deg, #ff8c00 0%, #ff7a00 100%);
  transform: translateY(-2px);
  box-shadow: 0 4px 12px rgba(255, 122, 0, 0.3);
}

.doc-preview-container {
  margin-top: 12px;
  position: relative;
  display: inline-block;
}

.doc-previews-container {
  display: flex;
  gap: 15px;
  justify-content: center;
  margin-top: 15px;
  flex-wrap: wrap;
}

.doc-preview-item {
  position: relative;
  display: inline-block;
  background: #fff;
  padding: 8px;
  border-radius: 10px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);

}
.dark-mode-wrapper.dark-mode .earnings-row {
  border-bottom-color: rgba(255, 255, 255, 0.08);
}
.dark-mode-wrapper.dark-mode .earnings-modal {
  background: #1a1a2e;
}
.dark-mode-wrapper.dark-mode .earnings-modal h2 { color: #f3f4f6; }
.dark-mode-wrapper.dark-mode .earnings-modal input,
.dark-mode-wrapper.dark-mode .earnings-modal select {
  background: #12121f;
  border-color: rgba(255, 255, 255, 0.12);
  color: #f3f4f6;
}
.dark-mode-wrapper.dark-mode .earnings-modal-close {
  background: #2a2a3e;
  color: #cbd5e1;
}

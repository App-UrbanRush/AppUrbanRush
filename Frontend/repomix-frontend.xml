<file path="src/ui/pages/DeliveryRegister/DeliveryRegister.css">
/* CONTENEDOR */
.delivery-register-container {
  display: flex;
  height: 100vh;
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

/* ===== LEFT (FORM) ===== */
.delivery-register-left {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  background: #f8f9fb;
  padding: 20px;
}

/* LOGO MÓVIL (Oculto por defecto) */
.mobile-logo-form {
  display: none;
}

.delivery-register-card {
  background: #fff;
  padding: 40px;
  border-radius: 20px;
  width: 500px;
  min-height: 480px;
  max-height: 85vh;
  overflow-y: auto;
  flex-shrink: 0;
  box-shadow: 0px 20px 60px rgba(0, 0, 0, 0.15);
}

.delivery-register-header {
  text-align: center;
  margin-bottom: 30px;
}

.delivery-back-btn {
  background: linear-gradient(135deg, #ff7a00, #e96d00);
  border: none;
  color: #fff;
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  padding: 8px 18px;
  border-radius: 25px;
  transition: all 0.3s;
  margin-bottom: 12px;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  box-shadow: 0 4px 12px rgba(255, 122, 0, 0.3);
}

.delivery-back-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(255, 122, 0, 0.5);
}

.delivery-register-header h2 {
  color: #333;
  font-size: 28px;
  margin-bottom: 8px;
  font-weight: 600;
}

.delivery-register-header p {
  color: #666;
  font-size: 14px;
  margin: 0;
}

/* FORM SECTIONS */
.form-section {
  margin-bottom: 30px;
  padding-bottom: 20px;

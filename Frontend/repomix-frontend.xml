}

.dark-mode-wrapper.dark-mode .cart-drawer-item {
  border-bottom-color: #2d2d44;
}

.dark-mode-wrapper.dark-mode .cart-drawer-item-name {
  color: #f3f4f6;
}

.dark-mode-wrapper.dark-mode .cart-drawer-qty-btn {
  background: #2d2d44;
  border-color: #3d3d55;
  color: #9ca3af;
}

.dark-mode-wrapper.dark-mode .cart-drawer-qty-btn:hover {
  background: #3d3d55;
}

.dark-mode-wrapper.dark-mode .cart-drawer-qty {
  color: #f3f4f6;
}

.dark-mode-wrapper.dark-mode .cart-drawer-footer {
  border-top-color: #2d2d44;
}

.dark-mode-wrapper.dark-mode .cart-drawer-total-label {
  color: #9ca3af;
}

/* CONTENEDOR */
.register-container {
  display: flex;
  height: 100vh;
  font-family: Arial, sans-serif;
}

/* ===== LEFT (FORM) ===== */
.register-left {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  background: #f4f6f9;
  overflow-y: auto;
  padding: 24px;
}

.register-card {
  background: #fff;
  padding: 30px;
  border-radius: 15px;
  width: 420px;
  min-height: 480px;
  max-height: 85vh;
  overflow-y: auto;
  flex-shrink: 0;
  box-shadow: 0px 10px 25px rgba(0, 0, 0, 0.1);
}

.register-card h2 {
  margin-bottom: 20px;
}

.back-btn {
  background: linear-gradient(135deg, #ff7a00, #e96d00);
  border: none;
  color: #fff;
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  padding: 8px 18px;
  border-radius: 25px;
  transition: all 0.3s;
  margin-bottom: 12px;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  box-shadow: 0 4px 12px rgba(255, 122, 0, 0.3);
}

.back-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(255, 122, 0, 0.5);
}

/* INPUTS dentro de FormField */
.register-card input,
.register-card select,
.register-card .field-container input,
.register-card .field-container select {
  width: 100%;
  padding: 10px 12px;
  border-radius: 8px;
  border: 1px solid #ddd;
  outline: none;
  background: #fff;
  font-size: 14px;
  box-sizing: border-box;
}

.register-card input:focus,
.register-card select:focus {
  border-color: #ff7a00;
  box-shadow: 0 0 0 2px rgba(255, 122, 0, 0.2);
}

/* FILA */
.register-row {
  display: flex;
  gap: 12px;
}

.register-row > .field-container {
  flex: 1;
  min-width: 0;
}

/* BOTÓN */
.register-card button:not(.back-btn) {
  width: 100%;
  padding: 12px;
  background: #ff7a00;
  color: white;
  border: none;
  border-radius: 8px;
  cursor: pointer;
  transition: 0.3s;
  margin-top: 8px;
}

.register-card button:not(.back-btn):hover {
  background: #e96d00;
}

/* API ERROR */
.register-api-error {
  color: #e74c3c;
  font-size: 13px;
  margin-bottom: 12px;
  padding: 8px 12px;
  background: #fef2f2;
  border-radius: 8px;
  border: 1px solid #fecaca;
}

/* LINK */
.login-link {
  margin-top: 10px;
  font-size: 14px;
}

/* ===== RIGHT (IMAGEN) ===== */
.register-right {
  flex: 1;
  position: relative;
  overflow: hidden;
}

.register-right img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  transform-origin: center;
  will-change: transform;
  animation: reg-kenburns 22s ease-in-out infinite alternate;
}

/* Fade en el borde izquierdo: funde la imagen con el formulario */
.register-right::after {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  bottom: 0;
  width: 22%;
  background: linear-gradient(to left, rgba(248, 249, 251, 0) 0%, #f8f9fb 100%);
  pointer-events: none;
  z-index: 3;
}

@keyframes reg-kenburns {
  0%   { transform: scale(1) translate(0, 0); }
  50%  { transform: scale(1.12) translate(2%, 1.5%); }
  100% { transform: scale(1.18) translate(-2%, -1.5%); }
}
@keyframes reg-logo-float {
  0%, 100% { transform: translateY(0) scale(1); }
  50%      { transform: translateY(-14px) scale(1.03); }
}
@media (prefers-reduced-motion: reduce) {
  .register-right img,
  .register-overlay .register-logo-img { animation: none; }
}

/* OVERLAY CORRECTO */
.register-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    rgba(255, 106, 0, 0.32),
    rgba(255, 140, 0, 0.48)
  );
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  color: white;
  text-align: center;
}

.register-overlay .register-logo-img {
  width: 460px;
  height: 460px;
  object-fit: contain;
  margin-bottom: 20px;
  filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.3));
  animation: reg-logo-float 4.5s ease-in-out infinite;
}


/* ===== 📱 RESPONSIVE ===== */
@media (max-width: 900px) {
  .register-container {
    flex-direction: column;
    position: relative;
  }

  /* IMAGEN COMO FONDO */
  .register-right {
    position: absolute;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .register-right img {
    filter: brightness(0.9); /* oscurece para mejor lectura */
  }

  /* OVERLAY SOBRE IMAGEN */
  .register-overlay {
    justify-content: flex-start;
    padding-top: 40px;
  }

  .register-overlay .register-logo-img {
    width: 200px;
    height: 200px;
    object-fit: contain;
    margin-bottom: 15px;
    filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.3));
  }

  /* FORM ENCIMA */
  .register-left {
    position: relative;
    z-index: 2;
    background: transparent;
  }

  .register-card {
    width: 90%;
    backdrop-filter: blur(10px);
    background: rgba(255, 255, 255, 0.9);
    padding: 20px;
  }

  .register-row {
    flex-direction: column;
  }
}

.register-success-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
  animation: registerFadeIn 0.3s ease;
}

@keyframes registerFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.register-success-modal {
  background: #fff;
  border-radius: 20px;
  padding: 40px 35px;
  text-align: center;
  max-width: 380px;
  width: 90%;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
  animation: registerSlideUp 0.4s ease;
}

@keyframes registerSlideUp {
  from { opacity: 0; transform: translateY(30px) scale(0.95); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

.register-success-icon {
  width: 70px;
  height: 70px;
  background: linear-gradient(135deg, #ff7a00, #ff8c00);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 20px;
  font-size: 36px;
  color: #fff;
  font-weight: bold;
  box-shadow: 0 8px 25px rgba(255, 122, 0, 0.4);
}

.register-success-modal h3 {
  font-size: 22px;
  color: #1a1a2e;
  margin: 0 0 10px;
}

.register-success-modal p {
  font-size: 14px;
  color: #666;
  margin: 0 0 25px;
  line-height: 1.5;
}

.register-success-btn {
  width: 100%;
  padding: 14px;
  background: #ff7a00;
  color: white;

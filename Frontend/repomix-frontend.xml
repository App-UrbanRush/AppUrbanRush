.couriers-search {
  display: flex;
  align-items: center;
  gap: 8px;
  background: #fff;
  border: 1px solid #e5e7eb;
  border-radius: 10px;
  padding: 10px 16px;
  transition: border-color 0.2s;
}

.couriers-search:focus-within {
  border-color: #6c5ce7;
  box-shadow: 0 0 0 3px rgba(108, 92, 231, 0.1);
}

.couriers-search svg {
  color: #9ca3af;
  flex-shrink: 0;
}

.couriers-search input {
  border: none;
  outline: none;
  font-size: 14px;
  color: #333;
  background: transparent;
  width: 220px;
}

.couriers-search input::placeholder {
  color: #9ca3af;
}

/* Tabs */
.couriers-tabs {
  display: flex;
  gap: 8px;
  margin-bottom: 24px;
  flex-wrap: wrap;
}

.couriers-tab {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 16px;
  border: 1px solid #e5e7eb;
  border-radius: 8px;
  background: #fff;
  color: #6b7280;

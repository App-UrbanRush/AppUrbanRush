.earnings-account-del:hover { background: #fee2e2; }

/* Tabla de entregas */
.earnings-table {
  display: flex;
  flex-direction: column;
}

.earnings-row {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr 1fr;
  align-items: center;
  padding: 13px 8px;
  border-bottom: 1px solid #f3f4f6;
  font-size: 14px;
}

.earnings-row:last-child { border-bottom: none; }

.earnings-row-order { font-weight: 800; color: #1f2430; }
.earnings-row-fee { font-weight: 700; color: #16a34a; }

.earnings-row-status {
  justify-self: start;
  font-size: 11px;
  font-weight: 800;
  text-transform: uppercase;
  padding: 4px 10px;
  border-radius: 999px;
}

.earnings-row-status.paid { background: #dcfce7; color: #16a34a; }
.earnings-row-status.pending { background: #fef9c3; color: #ca8a04; }

.earnings-row-date { color: #8a909c; font-size: 13px; justify-self: end; }

/* Modal */
.earnings-modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2000;
  padding: 20px;
}

.earnings-modal {
  background: #fff;
  border-radius: 20px;
  padding: 28px;
  width: 100%;
  max-width: 440px;
  position: relative;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.25);
  animation: earnings-modal-in 0.2s ease;
}

@keyframes earnings-modal-in {
  from { opacity: 0; transform: translateY(10px) scale(0.98); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

.earnings-modal h2 {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 19px;
  font-weight: 800;
  color: #1f2430;
  margin: 0 0 18px;
}

.earnings-modal h2 svg { color: #ff8c00; }

.earnings-modal label {
  display: block;
  font-size: 12px;
  font-weight: 700;
  color: #6b7280;
  margin: 12px 0 5px;
}

.earnings-modal input,
.earnings-modal select {
  width: 100%;
  padding: 11px 13px;
  border: 1px solid #ddd;
  border-radius: 10px;
  font-size: 14px;
  outline: none;
  transition: 0.25s;
  background: #fff;
}

.earnings-modal input:focus,
.earnings-modal select:focus {
  border-color: #ff6a00;
  box-shadow: 0 0 0 2px rgba(255, 106, 0, 0.2);
}

.earnings-form-row {
  display: flex;
  gap: 12px;
}

.earnings-form-row .grow { flex: 1; }

.earnings-modal-save {
  width: 100%;
  margin-top: 22px;
  padding: 13px;
  border: 0;
  border-radius: 12px;
  background: linear-gradient(90deg, #ff6a00, #ff8c00);
  color: #fff;
  font-size: 15px;
  font-weight: 800;
  cursor: pointer;
  transition: all 0.25s ease;
}

.earnings-modal-save:hover:not(:disabled) {
  transform: translateY(-2px);
  box-shadow: 0 8px 20px rgba(255, 106, 0, 0.4);
}

.earnings-modal-save:disabled { opacity: 0.6; cursor: not-allowed; }

.earnings-modal-close {
  position: absolute;
  top: 16px;

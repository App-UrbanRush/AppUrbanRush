}

.courier-modal-field-icon.blue { background: #eff6ff; color: #3b82f6; }
.courier-modal-field-icon.green { background: #f0fdf4; color: #22c55e; }
.courier-modal-field-icon.purple { background: #faf5ff; color: #a855f7; }

.courier-modal-field div {
  display: flex;
  flex-direction: column;
}

.courier-modal-label {
  font-size: 11px;
  font-weight: 600;
  color: #9ca3af;
